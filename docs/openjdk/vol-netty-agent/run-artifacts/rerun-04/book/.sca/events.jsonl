{"seq":1,"type":"spec.admitted","version":1,"ts":"2026-08-20T02:16:00.238Z","durable":true,"run_id":"2b6968188eff","payload":{"spec_version":1,"spec":{"meta":{"book_id":"netty-source-book","title":"Netty 源码教学书","source_repo":"openjdk-book.git","source_version":"1350397a7bac","created_at":"2026-08-20T02:16:00.236Z"},"goal":"帮助读者通过阅读 Netty 源码真正掌握其执行骨架、内存模型、发送路径与工程权衡。","scope":[{"name":"Netty 核心主线与横切机制","level":"core","design_decisions":["EventLoop 单线程执行骨架","Channel/Unsafe 分层","Pipeline 双向传播","ByteBuf 所有权与引用计数","池化分配器层级结构","发送路径与背压"],"confidence":"high"}],"non_goals":["不以入门示例或 Echo Server 作为全书主线","不把 HTTP/HTTP2/WebSocket 这类外围协议层提前为核心章节","不把 API 使用说明替代机制解释"],"reader_profile":{"level":"beginner","assumptions":["了解 Java 基础语法","理解线程、任务、I/O 的基础概念","愿意通过源码建立系统级直觉，而不是只记 API"],"goal":"book","views":["single","performance"]},"chapters":[{"id":1,"title":"EventLoop / EventExecutor：I/O、任务与时间的统一执行骨架","depth":"A","kps":["理解 EventLoop 不只是线程模型，而是统一执行语义","解释 I/O 事件、普通任务、定时任务为何共处同一骨架","说明线程亲和如何降低同步成本并约束后续章节"],"prereqs":[],"interview_points":[]},{"id":2,"title":"Channel / Unsafe：公开 API 背后的真实 I/O 边界","depth":"A","kps":["理解 Channel 生命周期与底层 I/O 抽象边界","解释 Unsafe 为什么存在，以及它和公开 API 的职责分层","说明 transport 实现如何被吸进统一抽象"],"prereqs":[1],"interview_points":[]},{"id":3,"title":"Pipeline / HandlerContext：Netty 的事件传播主链","depth":"A","kps":["区分 inbound 与 outbound 的传播方向与语义","理解 Handler 与 Context 分离的必要性","说明 add/remove/replace 为什么会影响控制流而不只是链表结构"],"prereqs":[1,2],"interview_points":[]},{"id":4,"title":"ByteBuf：索引模型、所有权与引用计数","depth":"A","kps":["掌握 readerIndex / writerIndex / capacity 的认知模型","理解 ByteBuf 的所有权语义以及 retain/release 的边界","识别 ByteBuf 与普通 ByteBuffer 的根本差异"],"prereqs":[1,2,3],"interview_points":[]},{"id":5,"title":"PooledByteBufAllocator：Arena / Chunk / Subpage 的层级分配体系","depth":"A","kps":["理解 Arena / Chunk / Subpage 的分层关系","追踪池化分配路径与回收路径","解释池化如何降低分配与 GC 成本，以及引入了什么复杂度"],"prereqs":[4],"interview_points":[]},{"id":6,"title":"OutboundBuffer / write / flush：发送路径、背压与可写性边界","depth":"A","kps":["解释 write 与 flush 为什么分离","理解 OutboundBuffer 如何承接发送路径","说明 writability、背压与内存占用之间的约束关系"],"prereqs":[2,3,4],"interview_points":[]},{"id":7,"title":"Promise / Future / task queue：异步结果如何回到执行骨架","depth":"B","kps":["理解 Promise / Future 在控制流中的角色","说明 listener 与 task queue 如何回接 EventLoop","避免把异步 API 理解成孤立回调工具"],"prereqs":[1,2,3],"interview_points":[]},{"id":8,"title":"FastThreadLocal / Recycler / LeakDetector：横切工程机制","depth":"B","kps":["识别 FastThreadLocal / Recycler / LeakDetector 各自解决的问题","解释它们为什么属于横切工程机制而不是局部技巧","建立性能、安全与可调试性的统一视角"],"prereqs":[1,4,5,6],"interview_points":[]},{"id":9,"title":"横切专题：线程亲和、引用计数与背压","depth":"A","kps":["把线程亲和、所有权和发送路径统一成横切理解轨","解释多个主线机制为什么共同受这些约束支配","建立跨章节可迁移的系统设计直觉"],"prereqs":[1,4,5,6,7,8],"interview_points":[]},{"id":10,"title":"Bootstrap / ServerBootstrap / ChannelInitializer：系统如何被装配起来","depth":"B","kps":["理解 Bootstrap 与 ServerBootstrap 的装配职责","解释 parentGroup / childGroup 的边界","说明装配层为什么不能反客为主替代主线机制"],"prereqs":[1,2,3,7],"interview_points":[]},{"id":11,"title":"Codec：协议抽象如何建立在 Pipeline + ByteBuf 之上","depth":"B","kps":["理解 codec 为什么必须晚于 Pipeline 与 ByteBuf","分析 ByteToMessageDecoder / MessageToMessageCodec 的抽象价值","说明协议装配如何复用主线机制"],"prereqs":[3,4,10],"interview_points":[]},{"id":12,"title":"零拷贝与 CompositeByteBuf：发送优化的真实收益与代价","depth":"B","kps":["理解 FileRegion / sendfile / CompositeByteBuf 的真实优化路径","区分零拷贝适用场景与误用边界","把它和发送路径、内存管理联系起来理解"],"prereqs":[4,5,6],"interview_points":[]},{"id":13,"title":"HTTP / HTTP2 / timeout / websocket：外围协议与应用层能力","depth":"C","kps":["理解这些协议模块为什么属于外围层而不是主线机制","说明它们如何建立在 EventLoop、Pipeline、ByteBuf 之上","避免把上层协议案例误当系统本质"],"prereqs":[10,11,12],"interview_points":[]},{"id":14,"title":"高风险误区：哪里最容易学错、用错、排障失败","depth":"B","kps":["识别最容易被误读的机制边界","理解引用计数、线程亲和、flush 边界的高风险点","建立从症状反推源码位置的排障路径"],"prereqs":[1,2,3,4,5,6,7,8],"interview_points":[]},{"id":15,"title":"历史演进、可迁移思想与费曼式自测","depth":"B","kps":["区分当前主路径与历史兼容层","抽取可迁移到其他中间件/系统的通用思想","用自测问题确认自己真的理解了 Netty 的主线机制"],"prereqs":[1,2,3,4,5,6,7,8,9],"interview_points":[]}],"success_criteria":[{"id":"c1","description":"能解释 EventLoop/Channel/Pipeline 如何构成执行骨架","required":true},{"id":"c2","description":"能说明 ByteBuf、Allocator、OutboundBuffer 三者如何共同决定内存与发送路径","required":true},{"id":"c3","description":"能识别 Netty 中最容易误解、误用、泄漏的高风险点","required":true},{"id":"c4","description":"能把主线机制与横切机制区分开来，并做迁移解释","required":true}],"allowed_operations":["read","run_demo","write_book"],"spec_version":1}}}
